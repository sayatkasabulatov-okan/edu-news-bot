# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
MODERATOR_CHAT_ID=123456789
CHANNEL_ID=-1001234567890

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edu_news_bot
DB_USER=postgres
DB_PASSWORD=your_password_here

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Scraping Configuration
SCRAPING_SCHEDULE_HOUR=9
MIN_ARTICLES_FOR_DIGEST=3
MAX_ARTICLES_FOR_DIGEST=5

# Logging
LOG_LEVEL=INFO

# Article Mode Configuration (NEW)
SCRAPING_INTERVAL_HOURS=4
ENABLE_DIGEST_MODE=false
ENABLE_ARTICLE_MODE=true
MAX_ARTICLE_SUMMARY_SENTENCES=5
SEND_ARTICLES_IMMEDIATELY=true
